{
  "expo": {
    "name": "BRICK DEAL",
    "slug": "brickdeal",
    "owner": "brickfood123s-team",
    "scheme": "brickdeal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Icone.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#D60309"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brickfood.brickdeal"
    },
    "android": {
      "package": "com.brickfood.brickdeal",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Icone.png",
        "backgroundColor": "#D60309"
      }
    },
    "web": {
      "favicon": "./assets/Icone.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "290b1fcf-922d-46a2-8ff9-1e5148233da6"
      }
    }
  }
}

{
  "expo": {
    "name": "BRICK DEAL",
    "slug": "brickdeal",
    "owner": "brickfood123s-team",
    "scheme": "brickdeal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Icone.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#D60309"
    },
    "notification": {
      "icon": "./assets/icon_notification.png",
      "color": "#D60309"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brickfood.brickdeal",
      "infoPlist": {
        "NSCameraUsageDescription": "BrickDeal a besoin d'accéder à votre caméra pour scanner les QR codes des réservations."
      }
    },
    "android": {
      "package": "com.brickfood.brickdeal",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      "adaptiveIcon": {
        "foregroundImage": "./assets/Icone.png",
        "backgroundColor": "#D60309"
      }
    },
    "web": {
      "favicon": "./assets/Icone.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "BrickDeal a besoin d'accéder à votre caméra pour scanner les QR codes des réservations.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "290b1fcf-922d-46a2-8ff9-1e5148233da6"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/290b1fcf-922d-46a2-8ff9-1e5148233da6"
    }
  }
}
